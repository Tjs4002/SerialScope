<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package manifest, filled in by tools\make-msix.ps1 (version and display name).
     Identity values come from Partner Center (Product management > Product identity). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Tjs4002.SerialScope"
    Publisher="CN=20B67E04-FF4D-4504-8E64-001E956A11D0"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{DISPLAYNAME}</DisplayName>
    <PublisherDisplayName>Tjs4002</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Serial monitor and live plotter for ESP32, Arduino and any serial device.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SerialScope" Executable="SerialScope.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{DISPLAYNAME}"
        Description="Serial monitor and live plotter for ESP32, Arduino and any serial device."
        BackgroundColor="#0B0F0D"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
